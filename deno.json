{
  "license": "MIT",
  // Vite's plugin resolution needs a real node_modules directory.
  "nodeModulesDir": "auto",
  "tasks": {
    // --unstable-kv is required for Deno.openKv outside Deno Deploy.
    "dev": "deno run -A --unstable-kv --env-file npm:vite",
    "build": "deno run -A --unstable-kv --env-file npm:vite build",
    "start": "deno serve -A --unstable-kv _fresh/server.js",
    "check": "deno fmt --check && deno lint && deno check .",
    "test": "deno test -A --unstable-kv",
    "test:watch": "deno test -A --unstable-kv --watch"
  },
  "lint": {
    "rules": { "tags": ["fresh", "recommended"] },
    "exclude": ["_fresh", "stitch_smash_club_sports_utility"]
  },
  "fmt": {
    "exclude": ["_fresh", "stitch_smash_club_sports_utility", "Logos"]
  },
  "exclude": ["_fresh", "stitch_smash_club_sports_utility"],
  "imports": {
    "fresh": "jsr:@fresh/core@^2.1.1",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.6",
    "preact": "npm:preact@^10.27.2",
    "@preact/signals": "npm:@preact/signals@^2.3.1",
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.9",
    "imagescript": "npm:imagescript@^1.3.1",
    "tailwindcss": "npm:tailwindcss@^4.1.14",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.14",
    "vite": "npm:vite@^7.1.7",
    "@/": "./"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  }
}
