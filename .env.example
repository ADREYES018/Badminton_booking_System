# Copy to .env and fill in. Never commit .env.

# Public origin, used to build magic links and QR payloads.
APP_URL=http://localhost:8000

# Seeded platform owner. This email is promoted to super_admin on first login.
SUPER_ADMIN_EMAIL=you@example.com

# 32-byte base64 key for AES-256-GCM encryption of player refund IBANs.
# Generate: deno run -A tools/genkey.ts
IBAN_ENC_KEY=

# 32-byte base64 secret for signing session ids and rotating QR tokens.
# Generate: deno run -A tools/genkey.ts
APP_SECRET=

# Resend API key. Leave blank in development to log emails to the console.
RESEND_API_KEY=
EMAIL_FROM="Smash Club <noreply@example.com>"

# Local Deno KV path. Unset on Deno Deploy, which provides managed KV.
KV_PATH=./data/smash-club.kv
