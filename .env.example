# Copy to .env and fill in. Never commit .env.

# Public origin, used to build magic links and QR payloads.
APP_URL=http://localhost:8000

# Seeded platform owner. This email is promoted to super_admin on first login.
SUPER_ADMIN_EMAIL=you@example.com

# 32-byte base64 key for AES-256-GCM encryption of player refund IBANs.
# Generate: deno run -A tools/genkey.ts
IBAN_ENC_KEY=

# 32-byte base64 secret for signing session ids and check-in QR tokens.
# Generate: deno run -A tools/genkey.ts
APP_SECRET=

# Gmail API credentials. Leave GMAIL_REFRESH_TOKEN blank in development to log
# emails to the console instead of sending them. See README for how to obtain
# these — the refresh token needs a one-time OAuth consent, and the consent
# screen must be published or the token expires after seven days.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Required. Must name the Gmail account that authorised the refresh token:
# Gmail silently rewrites a From it does not recognise as an alias of that
# account, so a wrong value here sends under the wrong address with no error.
EMAIL_FROM="Smash Club <smashclub.dxb@gmail.com>"

# Local Deno KV path. Unset on Deno Deploy, which provides managed KV.
KV_PATH=./data/smash-club.kv
